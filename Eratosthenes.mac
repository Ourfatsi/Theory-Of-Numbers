Eratosthenes(N):=block(
	/*Filling numbres from 2 to N*/
	L:[],
	for k : 2 thru N do (L:append(L,[k])),
	/*Removing compound numbers up to N*/
	counter:1,
	while (counter < length(L)) do(
		i:L[counter],
		j:i,
		while (i*j < N+1) do(
			if (member(i*j,L)) then (L:delete(i*j,L)), /*DeepSeek proposition*/
			j:j+1),
		counter:counter + 1),
	return(L)	
)$
