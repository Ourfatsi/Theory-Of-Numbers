is_inside(x,L):=block(
	flag:False,
	k:1,
	while(flag = False and (k<=length(L))) do (
		if x=L[k] then(flag:True),
		k:k+1),
	return(flag)
)$

Eratosthene(N):=block(
	L:[],
	for k : 2 thru N-1 do(L:append(L,[k])),
	i:L[1],
    	while(i^2 < N+1) do(
		L:delete(i,L),
		L:delete(i^2,L),
		j:i+1,
	while(i*j < N+1) do(
		/*if is_inside(i*j,L)=True  then (L:delete(i*j,L)),*/
		if member(i*j,L)  then (L:delete(i*j,L)), /*DeepSeek proposition*/
    		j:j+1),
 	i:L[1]),
	return(L)
)$
